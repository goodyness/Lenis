# =============================================================================
# Lenis Platform -- Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.
# =============================================================================

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_NAME=Lenis
APP_ENV=development         # development | production
DEBUG=false

# ------------------------------------------------------------------
# Database
# SQLite for development; PostgreSQL for production.
# ------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./lenis_dev.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lenis

# ------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------
# Celery
# ------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------
# JWT -- RS256 key pair
#
# Generate a fresh key pair with:
#   python scripts/generate_keypair.py
#
# Paste the PEM content here with literal \n in place of newlines,
# or use a multiline value in this file (both formats are accepted).
# ------------------------------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nPLACEHOLDER_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPLACEHOLDER_PUBLIC_KEY\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=lenis
JWT_AUDIENCE=lenis-api

# ------------------------------------------------------------------
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# SMTP / Email Configuration
# ------------------------------------------------------------------
# Default local development (logs email links to terminal):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=noreply@lenis.io
SMTP_FROM_NAME=Lenis Pay
SMTP_TLS=false
SMTP_START_TLS=false

# --- For Testing Real Emails with Gmail SMTP ---
# 1. Enable 2-Step Verification on your Google Account.
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Uncomment and fill below:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM_ADDRESS=your_email@gmail.com
# SMTP_FROM_NAME=Lenis Pay
# SMTP_START_TLS=true
# SMTP_TLS=false

# ------------------------------------------------------------------
# Rate limiting
# ------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=10
LOGIN_FAILURE_MAX_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_SECONDS=600
LOGIN_BLOCK_TTL_SECONDS=900

# ------------------------------------------------------------------
# Frontend / CORS
# ------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------
# Testnet RPC endpoints (optional — used when TEST_MODE=true)
# ------------------------------------------------------------------
BASE_SEPOLIA_RPC_URL=
POLYGON_MUMBAI_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
OPTIMISM_SEPOLIA_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=
TESTNET_MODE=false
